{
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "releaseNotes"],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "releaseNotes": {
      "type": "string",
      "pattern": "^# What changed\\n\\n[\\s\\S]+\\n\\n## Changes since [^\\n]+\\n\\n\\| Commit \\| Message \\| Author \\|\\n\\| --- \\| --- \\| --- \\|[\\s\\S]*"
    }
  }
}
