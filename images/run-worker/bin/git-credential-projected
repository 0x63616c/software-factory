#!/bin/sh
set -eu

credential_dir="${RUN_WORKER_GITHUB_CREDENTIAL_DIR:-/var/run/secrets/software-factory/github}"

[ "${1:-}" = get ] || exit 0

# Git invokes helpers for every remote. Only answer GitHub HTTPS requests so a
# repository cannot redirect the installation credential to another host.
protocol=
host=
while IFS= read -r line && [ -n "$line" ]; do
  case "$line" in
    protocol=*) protocol="${line#protocol=}" ;;
    host=*) host="${line#host=}" ;;
  esac
done
[ "$protocol" = https ] || exit 0
[ "$host" = github.com ] || exit 0

login="$(cat "$credential_dir/login")"
token="$(cat "$credential_dir/token")"
[ -n "$login" ]
[ -n "$token" ]
printf 'username=%s\npassword=%s\n\n' "$login" "$token"
